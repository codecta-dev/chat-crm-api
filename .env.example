# Database configuration
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nestjs_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
DB_DATABASE=chat_crm_db

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
# Vacío = sin auth (solo desarrollo local sin password)
# REDIS_PASSWORD=

# Environment
NODE_ENV=development
PORT=3000

# JWT (genera uno propio: openssl rand -hex 32)
JWT_SECRET=change_me_jwt_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Cookie: 1 en producción HTTPS, 0 solo desarrollo local HTTP
COOKIE_SECURE=0

# AI
IA_URL=http://chat-crm-ia:8000

# Whatsapp (no commitear valores reales, solo placeholders)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change_me
