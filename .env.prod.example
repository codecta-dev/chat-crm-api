# .env.prod — PLANTILLA para el servidor. NO commitear valores reales.
# Copiar en servidor a .env.prod y rellenar con secretos (openssl rand -hex 32).
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nestjs_user
DB_PASSWORD=CHANGE_ME_segura_32_chars
DB_ROOT_PASSWORD=CHANGE_ME_root_segura_32_chars
DB_DATABASE=chat_crm_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_segura

NODE_ENV=production
PORT=3000

JWT_SECRET=CHANGE_ME_generar_con_openssl_rand_hex_32

# En prod: dominio o IP Tailscale del front (sin trailing slash)
# Ej. Tailscale: http://100.77.254.40:8081
CORS_ORIGIN=http://100.77.254.40:8081
COOKIE_SECURE=0
# Si hay HTTPS con reverse proxy -> COOKIE_SECURE=1

# IA en la misma red crm-network (nombre del servicio en compose)
IA_URL=http://chat-crm-ia:8000

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
